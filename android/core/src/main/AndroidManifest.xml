<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine opens sockets to other devices. Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Discovery (mDNS): watching for network changes and receiving multicast on Wi-Fi.
         Both are granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Android 17+: people allow local network access; the app asks before discovery. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Transfers keep running with the screen off or the app closed, only while they run
         (a dataSync foreground service). Notifications show their progress; Android 13+
         asks people before showing them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".transfers.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
