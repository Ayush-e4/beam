<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The engine opens sockets to other devices. Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Discovery (mDNS): watching for network changes and receiving multicast on Wi-Fi.
         Both are granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Android 17+: people allow local network access; the app asks before discovery. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- The phone's own hotspot, for devices with no shared Wi-Fi. Android 13+ asks people to
         allow nearby Wi-Fi devices (never used for location); older versions only let apps
         open a hotspot with the precise location permission, so Beam asks for it there and
         only for this (Android 12 asks for both, and people must pick precise). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Transfers keep running with the screen off or the app closed, only while they run
         (a dataSync foreground service). Notifications show their progress; Android 13+
         asks people before showing them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Clipboard links stay open in the background while devices are linked (a
         connectedDevice foreground service, allowed here by CHANGE_WIFI_MULTICAST_STATE). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- While transfers run, the CPU (and below Android 14, Wi-Fi) stays awake so they don't
         stall with the screen off. Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Received files go to Download/Beam. Android 11+ lets the app write there without
         asking; Android 10 and older need this permission (and legacy storage on 10). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application android:requestLegacyExternalStorage="true">
        <service
            android:name=".transfers.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".clipboard.ClipLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Reads the clipboard while it has focus, then closes; never in recents. -->
        <activity
            android:name=".clipboard.ClipFocusActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Beam.ClipFocus" />

        <!-- Received clipboard images, readable by the app they are pasted into. -->
        <provider
            android:name=".clipboard.ClipFileProvider"
            android:authorities="${applicationId}.beam.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/beam_clip_paths" />
        </provider>
    </application>

</manifest>
